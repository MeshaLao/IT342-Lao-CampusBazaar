<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Order number + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOrderNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ORD-123456"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#421C3B"/>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024-01-01"
                    android:textSize="11sp"
                    android:textColor="#9ca3af"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="#33B28E3A"
                android:textColor="#B28E3A"/>
        </LinearLayout>

        <!-- Items -->
        <TextView
            android:id="@+id/tvItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Product name × 1"
            android:textSize="13sp"
            android:textColor="#421C3B"
            android:layout_marginBottom="4dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#f0ebe0"
            android:layout_marginVertical="10dp"/>

        <!-- Payment + Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvPayment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Campus Meet-up (Cash)"
                android:textSize="11sp"
                android:textColor="#6b7280"/>

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#B28E3A"/>
        </LinearLayout>

        <!-- Meet-up details box -->
        <LinearLayout
            android:id="@+id/layoutMeetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#F9F7F2"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Meet-up Details"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#421C3B"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvMeetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#6b7280"/>
        </LinearLayout>

        <!-- QR Code box -->
        <LinearLayout
            android:id="@+id/layoutQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#F9F7F2"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Meet-Up QR Code"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#421C3B"
                android:layout_marginBottom="8dp"/>

            <ImageView
                android:id="@+id/ivQr"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:contentDescription="QR Code"
                android:background="#FFFFFF"
                android:padding="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show this to the seller to confirm handover"
                android:textSize="11sp"
                android:textColor="#6b7280"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>