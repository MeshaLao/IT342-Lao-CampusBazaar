<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Main navbar row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:background="#1D5D5D"
        android:gravity="center_vertical">

        <!-- Logo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/cb_logo"
                android:scaleType="centerCrop"
                android:contentDescription="Campus Bazaar Logo"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CampusBazaar"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#B28E3A"
                    android:fontFamily="serif"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THE STUDENT SOUK"
                    android:textSize="7sp"
                    android:textColor="#E8E4C9"
                    android:letterSpacing="0.1"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Nav buttons -->
        <TextView
            android:id="@+id/navBrowse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browse"
            android:textSize="12sp"
            android:textColor="#E8E4C9"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"/>

        <TextView
            android:id="@+id/navOrders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Orders"
            android:textSize="12sp"
            android:textColor="#E8E4C9"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"/>

        <!-- User initial circle -->
        <FrameLayout
            android:id="@+id/navUserCircle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="#B28E3A">
            <TextView
                android:id="@+id/navUserInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="U"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#421C3B"/>
        </FrameLayout>

        <!-- Logout -->
        <TextView
            android:id="@+id/navLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬡"
            android:textSize="18sp"
            android:textColor="#E8E4C9"
            android:layout_marginStart="10dp"
            android:paddingVertical="6dp"/>
    </LinearLayout>

    <!-- Gold border -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#B28E3A"/>
</LinearLayout>