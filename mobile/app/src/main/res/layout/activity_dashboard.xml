<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E8E4C9">

    <include layout="@layout/navbar"/>

    <!-- Tab bar (replaces web sidebar) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tabListings"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Your Listings"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#E8E4C9"
                android:background="#1D5D5D"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tabRejected"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Rejected"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#A3464D"
                android:background="#A3464D22"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tabOrders"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Orders to Fulfill"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#421C3B"
                android:background="#E8E4C9"
                android:layout_marginEnd="6dp"/>

            <!-- Admin-only tab -->
            <TextView
                android:id="@+id/tabAdminStats"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Platform Stats"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#421C3B"
                android:background="#E8E4C9"
                android:visibility="gone"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Content area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- LISTINGS TAB -->
        <LinearLayout
            android:id="@+id/contentListings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Your Listings"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="#421C3B"/>

                <Button
                    android:id="@+id/btnNewListing"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+ New Listing"
                    android:textSize="12sp"
                    android:backgroundTint="#B28E3A"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="12dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvListings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:clipToPadding="false"/>

            <TextView
                android:id="@+id/tvListingsEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No listings yet. Create your first!"
                android:textColor="#421C3B"
                android:textSize="14sp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- REJECTED TAB -->
        <LinearLayout
            android:id="@+id/contentRejected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rejected Listings"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="#421C3B"
                android:padding="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRejected"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:clipToPadding="false"/>

            <TextView
                android:id="@+id/tvRejectedEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No rejected listings!"
                android:textColor="#6F803C"
                android:textSize="14sp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ORDERS TAB -->
        <LinearLayout
            android:id="@+id/contentOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Orders to Fulfill"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="#421C3B"
                android:padding="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:clipToPadding="false"/>

            <TextView
                android:id="@+id/tvOrdersEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No orders yet!"
                android:textColor="#421C3B"
                android:textSize="14sp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ADMIN STATS TAB -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentAdminStats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Platform Statistics"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="#421C3B"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:baselineAligned="false"
                    android:layout_marginBottom="16dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvTotalOrders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#421C3B"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Orders"
                                android:textSize="11sp"
                                android:textColor="#B28E3A"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvTotalUsers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#421C3B"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Users"
                                android:textSize="11sp"
                                android:textColor="#1D5D5D"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvTotalProducts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#421C3B"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Products"
                                android:textSize="11sp"
                                android:textColor="#6F803C"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="#B28E3A"/>

        <!-- Hidden views needed by DashboardActivity -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/tvRole"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <Button
            android:id="@+id/btnBrowse"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <Button
            android:id="@+id/btnMyOrders"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/layoutAdminStats"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>