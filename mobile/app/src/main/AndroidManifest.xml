<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lao.myapplication">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Campus Bazaar"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".feature.auth.RegisterActivity" />
        <activity android:name=".feature.auth.LoginActivity" />
        <activity android:name=".feature.dashboard.DashboardActivity" />
        <activity android:name=".feature.marketplace.MarketplaceActivity" />
        <activity android:name=".feature.orders.MyOrdersActivity" />

    </application>

</manifest>
